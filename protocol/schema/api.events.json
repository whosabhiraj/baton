{
  "$id": "baton/1/api.events",
  "title": "api.events",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "GET /api/runs/{id}/events response (A11): events with seq > since.",
  "type": "object",
  "properties": {
    "ok": { "type": "boolean", "const": true },
    "events": { "type": "array", "items": { "$ref": "#/$defs/stored_event" } }
  },
  "required": ["ok", "events"],
  "additionalProperties": {},
  "$defs": {
    "stored_event": {
      "type": "object",
      "properties": {
        "v": { "type": "number", "const": 1 },
        "run_id": { "type": "string" },
        "agent_id": { "type": "string" },
        "seq": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "ts": { "type": "string" },
        "type": { "type": "string" },
        "payload": { "type": "object", "propertyNames": { "type": "string" }, "additionalProperties": {} },
        "msg_id": { "type": "string" },
        "src": { "type": "string", "enum": ["cli", "spool", "hub", "adapter"] },
        "client_seq": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 }
      },
      "required": ["v", "run_id", "agent_id", "seq", "ts", "type", "payload", "msg_id", "src"],
      "additionalProperties": {}
    }
  }
}
