{
  "$id": "baton/1/api.notice",
  "title": "api.notice",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Data of an SSE hub frame (A14): hub-level notices that are not run events.",
  "type": "object",
  "properties": { "type": { "type": "string", "minLength": 1 } },
  "required": ["type"],
  "oneOf": [
    {
      "properties": {
        "type": { "const": "config_reloaded" },
        "version": { "type": "integer", "minimum": 0 },
        "ok": { "type": "boolean" },
        "issues": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["type", "version", "ok", "issues"]
    },
    {
      "properties": {
        "type": { "const": "spool_warning" },
        "run_id": { "type": "string" },
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      },
      "required": ["type", "run_id", "code", "detail"]
    },
    {
      "properties": {
        "type": { "const": "conductor" },
        "state": { "enum": ["off", "idle", "thinking", "acting"] },
        "account": { "type": "string" },
        "model": { "type": "string" },
        "since": { "type": "string" }
      },
      "required": ["type", "state", "since"]
    },
    {
      "properties": {
        "type": { "const": "approval" },
        "approval": { "type": "object" }
      },
      "required": ["type", "approval"]
    },
    {
      "properties": {
        "type": { "const": "idle_stop" },
        "after_min": { "type": "number", "minimum": 0 }
      },
      "required": ["type", "after_min"]
    }
  ]
}
